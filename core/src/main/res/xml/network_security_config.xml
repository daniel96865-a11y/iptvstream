<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- IPTV-Zugänge und der Fernseher im Heimnetz sprechen oft unverschlüsselt. System-Zertifikate bleiben. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
